FROM mirror.gcr.io/library/python:3.12-slim
WORKDIR /workspace/backend
COPY backend/requirements-db.txt ./
RUN pip install --no-cache-dir -r requirements-db.txt pydantic==2.11.7 pydantic-settings==2.10.1 PyYAML==6.0.2
COPY backend/app ./app
COPY backend/scripts/db_admin.py ./scripts/db_admin.py
COPY backend/scripts/client_accounts.py ./scripts/client_accounts.py
COPY backend/scripts/lead_storage.py ./scripts/lead_storage.py
COPY backend/alembic.ini ./
COPY backend/migrations ./migrations
COPY backend/tests/test_db_foundation.py ./tests/test_db_foundation.py
USER 1000:1000
CMD ["python", "scripts/db_admin.py", "check"]
