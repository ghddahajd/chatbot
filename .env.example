LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_USE_STRUCTURED_CLASSIFIER=true
OPENAI_API_KEY=
GEMINI_API_KEY=

APP_ENV=development
DEV_MODE=true
DEFAULT_COMPANY_ID=rosh_import_demo
ALLOWED_ORIGINS=http://localhost:8000
OPERATOR_TOKEN=demo-operator-token

# Путь под уже смонтированным ./backend/data:/app/data (docker-compose.yml) — переживает
# рестарт контейнера. Без этого диалоги/сессии теряются при каждом перезапуске.
SESSION_SNAPSHOT_FILE=/app/data/session_snapshot.json

# Локальная LLM (Ollama, запускать НЕ в Docker — нативно на хосте
# для Metal acceleration на Apple Silicon)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:3b
# LLM_API_KEY=local
# LLM_USE_STRUCTURED_CLASSIFIER=true
# LLM_SKIP_CLASSIFIER_FOR_LOCAL=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# DELIVERY_OUTBOX_FILE=backend/logs/delivery_outbox.jsonl
