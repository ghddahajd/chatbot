.env
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.venv/
venv/

# Build / runtime
backend/logs/*.jsonl

# Live session state (real chat content, contact drafts) — must never be tracked
backend/data/session_snapshot.json

# Local client knowledge bases
backend/data/clients/*
!backend/data/clients/.gitkeep

# 2026-08-29 ("Настройки"-таб, TSK-06): локальные оверрайды базовых настроек клиента
# (app/config_overrides.py) — та же реальная клиентская информация (адрес/телефон/etc), что и
# clients/ выше, никогда не должна коммититься в этот репозиторий.
backend/data/overrides/*
!backend/data/overrides/.gitkeep

# 2026-08-29: реальный клон приватного rosh-client-data репо (см. reference_rosh_client_data_repo
# в памяти) — backend/data/clients/rosh_import_demo теперь symlink сюда. Локальная git-папка,
# не относится к этому проекту и не должна сюда коммититься.
/rosh-client-data/
# Локальный volume-маунт для symlink'а внутри Docker (см. комментарий в самом
# docker-compose.override.yml) — не коммитим: на сервере такой папки на диске нет, а тихо
# создать пустую и смонтировать её поверх реальных клиентских данных из docker-entrypoint.sh
# было бы серьёзной регрессией. Базовый docker-compose.yml (общий для локалки и сервера) этот
# фикс сознательно не трогает вообще.
docker-compose.override.yml

# Local client eval phrases
evals/clients/*
!evals/clients/.gitkeep
AGENTS.md
CLAUDE.md
CODEX.md
.agents/
.claude/
.codex/
.cursor/
.cursorrules
docs/
tasks/

# Local research / AI drafts
new/
test-sites/

# Local client intake materials
client-input/
tasks/debug_trace_runs/
