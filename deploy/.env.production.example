# Продакшн-конфиг backend — копировать в .env НА СЕРВЕРЕ (не коммитить с реальными
# значениями). Отличия от локального .env.example отмечены комментариями "ВАЖНО".

# ВАЖНО: должно быть production, иначе включаются dev-послабления в check_origin()
# (widget.py) — запросы без Origin-заголовка проходят, localhost разрешён всегда.
APP_ENV=production
DEV_MODE=false

# ВАЖНО (живой баг 2026-08-25): Docker-мост по умолчанию IPv4-only, а Telegram Bot API частично
# заблокирован по IPv4 именно в РФ-датацентрах — telegram_bridge ловил ConnectTimeout/"Network
# unreachable" из контейнера, хотя curl с самого хоста (рабочий IPv6) подключался нормально.
# host-режим даёт контейнеру тот же IPv6, что уже есть у хоста. UVICORN_HOST=127.0.0.1 обязателен
# вместе с этим — иначе uvicorn слушает 0.0.0.0 уже НЕ в изолированном network namespace,
# а прямо на публичном IP хоста, в обход nginx (см. docker-compose.yml).
DOCKER_NETWORK_MODE=host
UVICORN_HOST=127.0.0.1

# ВАЖНО: решённый провайдер для этого проекта — Yandex Alice AI LLM Flash напрямую через
# Yandex Cloud AI Studio (не реселлер, не Gemini — 152-ФЗ). LLM_API_KEY/LLM_BASE_URL/LLM_MODEL
# ниже оставить пустыми — get_settings() (config.py) сам подставит верные значения из
# YANDEX_API_KEY/YANDEX_FOLDER_ID (base_url на ai.api.cloud.yandex.net, модель — составной
# gpt://{folder_id}/{model} URI). Ключ и folder_id — в консоли Yandex Cloud AI Studio.
LLM_PROVIDER=yandex
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_USE_STRUCTURED_CLASSIFIER=true
OPENAI_API_KEY=
GEMINI_API_KEY=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

DEFAULT_COMPANY_ID=rosh_import_demo

# ВАЖНО: реальный домен клиники, БЕЗ localhost. Через запятую, если доменов несколько
# (например с www и без). Это CORS origin-лист (браузерный уровень) — отдельно от
# allowed_domains в company.yaml (application-уровень), должны указывать на один и тот
# же реальный домен.
ALLOWED_ORIGINS=https://medcenterrosh.ru,https://www.medcenterrosh.ru

# ВАЖНО: заменить на длинный случайный секрет (например `openssl rand -hex 32`).
# "demo-operator-token" — публично известное демо-значение, использовалось на показе,
# менять обязательно перед реальным продом.
OPERATOR_TOKEN=

# SESSION_SNAPSHOT_FILE тут не задаём — путь захардкожен в docker-compose.yml
# (environment: SESSION_SNAPSHOT_FILE), значение отсюда всё равно перезаписывается им.
# Персистентность (не теряет диалоги при рестарте контейнера) обеспечивает volume
# ./backend/data:/app/data в docker-compose.yml, а не эта переменная.

TELEGRAM_BOT_TOKEN=
# ВАЖНО: TELEGRAM_CHAT_ID — только для старого DM-пути (telegram_dm_enabled=false по
# умолчанию, можно оставить пустым). Активная система — Topics-мост (telegram_bridge_
# enabled=true по умолчанию, config.py): лиды/переписки летят в топики группы ниже, а не
# личным сообщением. Без двух переменных ниже бот стартует, но операторские уведомления
# лететь будет некуда.
TELEGRAM_CHAT_ID=
# ВАЖНО: id группы с Topics, включёнными в настройках группы (не обычный чат) — куда падают
# карточки лидов/жалоб с кнопкой "Взять в работу" (General) и пассивный лог (топик "Клиенты").
TELEGRAM_OPERATORS_GROUP_ID=
# ВАЖНО: id топика "Клиенты" внутри группы выше — пассивный лог обращений без needs_operator.
TELEGRAM_CLIENTS_TOPIC_ID=
# DELIVERY_OUTBOX_FILE=backend/logs/delivery_outbox.jsonl

# ВАЖНО: без этих двух переменных docker-entrypoint.sh молча пропускает подтяжку реальных
# клиентских данных и RAG-корпуса на старте контейнера (лог "skipping client data pull (local
# dev?)") — контейнер поднимется, но БЕЗ базы знаний клиента и БЕЗ статей для RAG. Локально их
# подставляют volume-mount'ы (./backend/data, ./client-input в docker-compose.yml), на сервере
# без bind-mount'ов их неоткуда больше взять. CLIENT_DATA_DEPLOY_KEY — приватный ключ (весь
# файл целиком, включая BEGIN/END строки) от read-only deploy key к приватному репозиторию
# ghddahajd/rosh-client-data. CLIENT_DATA_REPO_URL можно не задавать — совпадает со значением
# по умолчанию в docker-entrypoint.sh.
CLIENT_DATA_DEPLOY_KEY=
# CLIENT_DATA_REPO_URL=git@github.com:ghddahajd/rosh-client-data.git

CHAT_RATE_LIMIT_ENABLED=true
CHAT_RATE_LIMIT_PER_MINUTE=30
