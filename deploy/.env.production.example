# Продакшн-конфиг backend — копировать в .env НА СЕРВЕРЕ (не коммитить с реальными
# значениями). Отличия от локального .env.example отмечены комментариями "ВАЖНО".

# ВАЖНО: должно быть production, иначе включаются dev-послабления в check_origin()
# (widget.py) — запросы без Origin-заголовка проходят, localhost разрешён всегда.
APP_ENV=production
DEV_MODE=false

LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_USE_STRUCTURED_CLASSIFIER=true
OPENAI_API_KEY=
GEMINI_API_KEY=

DEFAULT_COMPANY_ID=rosh_import_demo

# ВАЖНО: реальный домен клиники, БЕЗ localhost. Через запятую, если доменов несколько
# (например с www и без). Это CORS origin-лист (браузерный уровень) — отдельно от
# allowed_domains в company.yaml (application-уровень), должны указывать на один и тот
# же реальный домен.
ALLOWED_ORIGINS=https://medcenterrosh.ru,https://www.medcenterrosh.ru

# ВАЖНО: заменить на длинный случайный секрет (например `openssl rand -hex 32`).
# "demo-operator-token" — публично известное демо-значение, использовалось на показе,
# менять обязательно перед реальным продом.
OPERATOR_TOKEN=

# ВАЖНО: без этого сессии/лиды/контекст диалогов теряются при каждом рестарте
# контейнера (деплое новой версии, падении процесса и т.д.) — на локальной демке было
# не критично, на реальном проде теряет реальные диалоги клиентов.
SESSION_SNAPSHOT_FILE=/app/logs/session_snapshot.json

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# DELIVERY_OUTBOX_FILE=backend/logs/delivery_outbox.jsonl

CHAT_RATE_LIMIT_ENABLED=true
CHAT_RATE_LIMIT_PER_MINUTE=30
